{
  "name": "mazerationsmeister",
  "version": "1.1.0",
  "description": "Protokollierung und Verwaltung von Mazerationen für die Gurktaler AG.",
  "author": "Wolfgang Kulmitzer <email@example.com>",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 9003",
    "dev:turbo": "next dev --turbopack -p 9003",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "electron-dev": "tsc --project electron/tsconfig.json && electron .",
    "electron-build": "next build && tsc --project electron/tsconfig.json && electron-builder",
    "build-fast": "node scripts/build-fast.js",
    "build-portable": "next build && tsc --project electron/tsconfig.json && electron-packager . MazerationsMeister --platform=win32 --arch=x64 --out=dist --overwrite --asar",
    "build-optimized": "node scripts/build-optimized-clean.js",
    "build-ultra": "node scripts/build-ultra-minimal.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.22.0",
    "@emnapi/runtime": "^1.4.5",
    "@genkit-ai/googleai": "^1.6.2",
    "@genkit-ai/next": "^1.6.2",
    "@hookform/resolvers": "^4.1.3",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/express": "^5.0.3",
    "@types/qrcode": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "electron-is-dev": "^3.0.1",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "genkit": "^1.6.2",
    "isomorphic-fetch": "^3.0.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.475.0",
    "next": "^15.2.3",
    "patch-package": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-color": "^2.19.3",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "genkit-cli": "^1.6.1",
    "pkg": "^5.8.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.mazerationsmeister.app",
    "productName": "MazerationsMeister",
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
      ".next/**/*",
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "package.json",
      "next.config.ts",
      "tailwind.config.ts",
      "postcss.config.mjs",
      "tsconfig.json",
      "!node_modules/@img/**",
      "!node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "forceCodeSigning": false,
      "extraFiles": [
        {
          "from": ".next",
          "to": ".next"
        }
      ]
    },
    "portable": {
      "artifactName": "MazerationsMeister-Portable-${version}.exe",
      "splashImage": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "MazerationsMeister-Setup-${version}.exe"
  }
}
